import { locale as rootLocale } from 'next/root-params'
import { DEFAULT_LOCALE, LOCALE_DESCRIPTORS, isLocale } from '@/i18n/config'
import { THEME_INIT_SCRIPT } from '@/lib/site-theme'
import '@/styles/globals.css'

/**
 * Root layout for the public website.
 *
 * It exists to sit *above* the `[locale]` segment. `<html>` and its bootstrap
 * script belong to the document, not to a language: when they lived inside
 * `[locale]/layout.tsx`, switching language changed a route segment, React
 * remounted that layout, and it re-created the `<script>` element on the client
 * — logging "Encountered a script tag while rendering React component" and
 * leaving a dead copy in `<head>` every time. Up here the element is rendered
 * once, hydrated, and never touched again, while the language-dependent shell
 * below re-renders freely.
 *
 * The admin application has its own root layout in a separate route group, so
 * the two surfaces share no shell, no providers and no client bundle.
 */

export default async function PublicRootLayout({
  children,
}: {
  children: React.ReactNode
}) {
  // `next/root-params` is how a root layout reads a parameter that is declared
  // below it. Without it this layout could not set `lang` at all, and a
  // screen reader would read every page in the wrong language.
  const value = await rootLocale()
  const descriptor = LOCALE_DESCRIPTORS[isLocale(value) ? value : DEFAULT_LOCALE]

  return (
    // `suppressHydrationWarning` covers exactly one attribute: `data-theme`,
    // which the bootstrap script writes before React ever runs. Without it
    // React sees an attribute the server did not send, warns, and — worse —
    // reverts it during hydration, so the page silently snaps back to light a
    // moment after loading. The suppression is one level deep by design: it
    // applies to <html>'s own attributes and nothing inside it.
    <html lang={descriptor.bcp47} dir={descriptor.direction} suppressHydrationWarning>
      <head>
        {/*
          Restores the visitor's saved theme before anything paints, or follows
          their operating system if they have never chosen. Inline and constant
          so the Content-Security-Policy can admit it by hash — see
          src/lib/site-theme.ts for why it cannot be rendered from the cookie on
          the server.
        */}
        <script dangerouslySetInnerHTML={{ __html: THEME_INIT_SCRIPT }} />
      </head>
      <body className="flex min-h-screen flex-col bg-[var(--surface-page)] antialiased">
        {children}
      </body>
    </html>
  )
}
