# ============================================================================
# VDS Dental Platform — environment template
# Copy to .env and fill in. NEVER commit .env. NEVER put secrets in source.
# ============================================================================

NODE_ENV=development

# --- Hosts -----------------------------------------------------------------
# Public site host and admin host. In production these MUST differ (§4/§81).
PUBLIC_HOST=localhost:3000
ADMIN_HOST=admin.localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000
# When true, the admin app is also reachable at /admin on the public host.
# Development convenience only — must be false in production.
ADMIN_PATH_FALLBACK=true

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://vds:vds_dev_password@localhost:5432/vds?schema=public
# Optional dedicated URL for migrations / long jobs
DIRECT_DATABASE_URL=

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vds-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL for served media (CDN in production)
S3_PUBLIC_BASE_URL=http://localhost:9000/vds-media

# --- Security --------------------------------------------------------------
# 32+ byte random strings. Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
ENCRYPTION_KEY=CHANGE_ME_32_byte_base64_key_for_secret_fields
# Comma-separated CIDRs. Empty = no IP restriction on admin.
ADMIN_IP_ALLOWLIST=
# Trust X-Forwarded-For (set true only behind a trusted proxy)
TRUST_PROXY=true

# --- Email -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="VDS Platform <noreply@example.com>"
# Where inquiry/security notifications go if no admin recipients are configured
MAIL_FALLBACK_TO=

# --- AI providers ----------------------------------------------------------
# Provider is selected per task in admin settings; supply keys for what you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Defaults; overridable from admin settings
AI_DEFAULT_CHAT_PROVIDER=anthropic
AI_DEFAULT_EMBED_PROVIDER=openai
AI_CHAT_MODEL_ANTHROPIC=claude-sonnet-4-5
AI_CHAT_MODEL_OPENAI=gpt-4.1
AI_EMBED_MODEL_OPENAI=text-embedding-3-small
AI_EMBED_DIMENSIONS=1536
# Hard ceiling regardless of admin settings (USD per calendar month)
AI_MONTHLY_BUDGET_USD=100

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Feature / operational flags -------------------------------------------
# Seed data refuses to load in production unless explicitly forced.
ALLOW_PRODUCTION_SEED=false
